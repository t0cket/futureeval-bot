# Copy to .env for local runs. In GitHub, add these as repository secrets instead.

# Required: token of the bot account (Metaculus > Settings > My forecasting bots)
METACULUS_TOKEN=

# Required: OpenRouter key. Use the key Metaculus sends after the credits form, or your
# own key with a credit limit set on it (the bot stops when less than $1 remains).
OPENROUTER_API_KEY=

# Optional: free AskNews access for tournament bots (see README)
ASKNEWS_CLIENT_ID=
ASKNEWS_SECRET=

# Optional overrides (defaults shown)
# FORECAST_MODEL=openrouter/anthropic/claude-opus-5.5
# FORECAST_EFFORT=high
# RESEARCH_MODEL=openrouter/anthropic/claude-opus-5.5
# WEB_SEARCH_RESULTS=8
# PARSER_MODEL=openrouter/anthropic/claude-haiku-4.5
# PREDICTIONS_PER_QUESTION=3
# INCLUDE_MINIBENCH=1
# MIN_CREDITS_USD=1.0
